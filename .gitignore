private-*.key

# Explicitly preserve Gradle wrapper files for reproducible builds on any machine
!android/gradlew
!android/gradlew.bat
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties
